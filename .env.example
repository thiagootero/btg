# =============================================================================
# Jornada de Impacto — variáveis de ambiente
# Copie para .env (desenvolvimento) e ajuste. NUNCA versione o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (MySQL 8)
# Formato: mysql://USUARIO:SENHA@HOST:3306/BANCO
# Em desenvolvimento no WSL, aponte para o MySQL local.
# Senhas com caracteres especiais precisam ser codificadas para URL (ex.: @ -> %40).
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://jornada:TROQUE_ESTA_SENHA@localhost:3306/jornada_impacto"

# Banco "sombra" usado apenas por `npx prisma migrate dev` (desenvolvimento).
# O usuário precisa ter permissão total nele. Não é usado em produção.
SHADOW_DATABASE_URL="mysql://jornada:TROQUE_ESTA_SENHA@localhost:3306/jornada_impacto_shadow"

# -----------------------------------------------------------------------------
# Autenticação (Better Auth)
# BETTER_AUTH_SECRET: segredo longo e aleatório (mín. 32 caracteres).
#   Gere com:  openssl rand -base64 32
# BETTER_AUTH_URL: URL pública da aplicação (sem barra no final).
#   Desenvolvimento: http://localhost:3000 · Produção: https://seu-dominio
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET="gere-um-segredo-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Consultor virtual (camada de IA)
# AI_PROVIDER=mock      -> respostas simuladas, sem chave, sem rede e sem custo (padrão)
# AI_PROVIDER=external  -> OpenAI (Responses API), ver docs/AI_INTEGRATION.md
# -----------------------------------------------------------------------------
AI_PROVIDER="mock"

# Obrigatória quando AI_PROVIDER=external. Lida SOMENTE no servidor: nunca use o
# prefixo NEXT_PUBLIC_ e nunca versione a chave.
# OPENAI_API_KEY=""
# Modelo (padrão: gpt-6.1-sol). gpt-5.4 foi testado; evite gpt-5.4-mini (gera caracteres de outro alfabeto).
# OPENAI_MODEL="gpt-6.1-sol"
# Opcionais:
# OPENAI_TIMEOUT_MS="60000"            # tempo máximo por chamada (padrão 60000)
# OPENAI_REASONING_EFFORT=""           # none|minimal|low|medium|high, só para modelos com raciocínio

# -----------------------------------------------------------------------------
# Seed de desenvolvimento (npx prisma db seed) — ignorado em produção
# Sem senha definida, o seed gera uma senha aleatória e a exibe uma única vez.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@jornada.local"
# SEED_ADMIN_PASSWORD=""
SEED_DEMO="true"
# SEED_DEMO_EMAIL="coordenacao@demo.jornada.local"
# SEED_DEMO_PASSWORD=""

# -----------------------------------------------------------------------------
# Produção com Docker Compose (usadas apenas pelo docker-compose.yml)
# -----------------------------------------------------------------------------
# Domínio público atendido pelo Caddy (HTTPS automático via Let's Encrypt).
APP_DOMAIN="jornada.exemplo.org.br"
# Credenciais do MySQL do container (defina senhas fortes e exclusivas).
MYSQL_DATABASE="jornada_impacto"
MYSQL_USER="jornada"
MYSQL_PASSWORD="TROQUE_ESTA_SENHA"
MYSQL_ROOT_PASSWORD="TROQUE_ESTA_SENHA_ROOT"
